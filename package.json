{
  "name": "bosang-dream",
  "version": "8.0.0",
  "private": true,
  "description": "보상드림 — 보상관리사 학습 PWA",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "content": "node scripts/build-content.mjs",
    "content:local": "node scripts/build-content.mjs --local-full",
    "serve": "python3 -m http.server 8080 --directory public",
    "deploy": "npm test && node scripts/build-content.mjs && firebase deploy"
  },
  "engines": {
    "node": ">=20"
  }
}
